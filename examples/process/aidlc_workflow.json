{
  "protocol": {
    "id": "aidlc-workflow",
    "name": "AWS AI Development Lifecycle Workflow",
    "kind": "process",
    "version": "1.0",
    "description": "Complete AIDLC workflow with 12 document types across 3 phases: Inception, Construction, and Operations",
    "category": "agent",
    "references": [
      {
        "name": "AWS AI DLC Documentation",
        "url": "https://docs.aws.amazon.com/prescriptive-guidance/latest/ai-driven-software-development/"
      }
    ]
  },
  "entities": [
    {
      "id": "vision_document",
      "name": "Vision Document",
      "type": "server",
      "description": "Strategic vision and product direction. Defines the problem space, target users, and success criteria.",
      "step_type": "llm",
      "inputs": [
        {
          "kind": "file",
          "name": "product_brief",
          "description": "Initial product brief or idea document",
          "required": true
        },
        {
          "kind": "object",
          "name": "market_context",
          "description": "Market analysis and competitive landscape"
        },
        {
          "kind": "object",
          "name": "stakeholder_input",
          "description": "Stakeholder interviews and feedback"
        }
      ],
      "outputs": [
        {
          "kind": "file",
          "name": "vision_document.md",
          "description": "Vision Document with problem statement, target users, value proposition, and success criteria"
        },
        {
          "kind": "object",
          "name": "vision_metadata",
          "description": "Structured vision metadata for downstream documents"
        }
      ],
      "processing": {
        "engine": "llm",
        "determinism": "non_deterministic",
        "model_policy": "quality-gated",
        "timeout": "10m",
        "cost_model": {
          "type": "token_based",
          "cost_unit": "USD",
          "input_token_cost": 0.003,
          "output_token_cost": 0.015,
          "estimated_input_tokens": 5000,
          "estimated_output_tokens": 3000
        },
        "latency_budget": {
          "p50": "2m",
          "p95": "5m",
          "p99": "8m",
          "max": "10m",
          "variance_class": "high"
        }
      },
      "failure_modes": [
        {
          "id": "insufficient_context",
          "name": "Insufficient Context",
          "description": "Product brief lacks necessary detail for vision creation",
          "severity": "high",
          "recovery": "Request additional stakeholder input"
        },
        {
          "id": "rate_limit",
          "name": "LLM Rate Limit",
          "description": "API rate limit exceeded",
          "severity": "medium",
          "recovery": "Retry with exponential backoff"
        }
      ],
      "retry_strategy": {
        "max_attempts": 3,
        "initial_delay": "5s",
        "max_delay": "60s",
        "backoff_multiplier": 2.0,
        "retry_on": ["rate_limit"]
      }
    },
    {
      "id": "requirements_spec",
      "name": "Requirements Specification",
      "type": "server",
      "description": "Detailed functional and non-functional requirements derived from the vision document.",
      "step_type": "llm",
      "inputs": [
        {
          "kind": "file",
          "name": "vision_document.md",
          "description": "Approved Vision Document",
          "required": true
        },
        {
          "kind": "object",
          "name": "vision_metadata",
          "description": "Structured vision metadata"
        },
        {
          "kind": "object",
          "name": "domain_constraints",
          "description": "Domain-specific constraints and regulations"
        }
      ],
      "outputs": [
        {
          "kind": "file",
          "name": "requirements_spec.md",
          "description": "Requirements Specification with functional requirements, non-functional requirements, and acceptance criteria"
        },
        {
          "kind": "object",
          "name": "requirements_matrix",
          "description": "Structured requirements for traceability"
        }
      ],
      "processing": {
        "engine": "llm",
        "determinism": "non_deterministic",
        "model_policy": "quality-gated",
        "timeout": "15m",
        "cost_model": {
          "type": "token_based",
          "cost_unit": "USD",
          "input_token_cost": 0.003,
          "output_token_cost": 0.015,
          "estimated_input_tokens": 8000,
          "estimated_output_tokens": 6000
        },
        "latency_budget": {
          "p50": "3m",
          "p95": "8m",
          "p99": "12m",
          "max": "15m",
          "variance_class": "high",
          "critical": true
        }
      },
      "failure_modes": [
        {
          "id": "ambiguous_vision",
          "name": "Ambiguous Vision",
          "description": "Vision document contains ambiguous goals",
          "severity": "high",
          "recovery": "Request vision clarification"
        },
        {
          "id": "rate_limit",
          "name": "LLM Rate Limit",
          "severity": "medium"
        }
      ],
      "retry_strategy": {
        "max_attempts": 3,
        "initial_delay": "5s",
        "max_delay": "60s",
        "backoff_multiplier": 2.0,
        "retry_on": ["rate_limit"]
      }
    },
