        "cost_model": {
          "type": "token_based",
          "cost_unit": "USD",
          "input_token_cost": 0.003,
          "output_token_cost": 0.015,
          "estimated_input_tokens": 12000,
          "estimated_output_tokens": 10000
        },
        "latency_budget": {
          "p50": "5m",
          "p95": "12m",
          "p99": "18m",
          "max": "20m",
          "variance_class": "high",
          "critical": true
        }
      },
      "failure_modes": [
