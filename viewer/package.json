{
  "name": "@grokify/pidl-viewer",
  "version": "0.10.0",
  "description": "Step-by-step walkthrough viewer for PIDL protocols, embeddable in any page",
  "keywords": [
    "pidl",
    "protocol",
    "walkthrough",
    "sequence-diagram",
    "viewer"
  ],
  "homepage": "https://github.com/grokify/pidl/blob/main/docs/guides/embedding.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grokify/pidl.git",
    "directory": "viewer"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist-lib/pidl-viewer.js",
  "module": "./dist-lib/pidl-viewer.mjs",
  "types": "./dist-lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/pidl-viewer.mjs",
      "default": "./dist-lib/pidl-viewer.js"
    },
    "./walkthrough.schema.json": "./dist-lib/walkthrough.schema.json"
  },
  "unpkg": "./dist-lib/pidl-viewer.js",
  "jsdelivr": "./dist-lib/pidl-viewer.js",
  "files": [
    "dist-lib"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "data": "go run ../cmd/pidl generate -f walkthrough-json -o public/walkthrough.json oauth2_api_access",
    "dev": "vite",
    "types": "node scripts/types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node -e \"require('node:fs').copyFileSync('../schema/walkthrough.schema.json', 'dist-lib/walkthrough.schema.json')\"",
    "build:embed": "npm run build && node scripts/embed.mjs",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
