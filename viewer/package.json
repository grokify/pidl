{
  "name": "pidl-viewer",
  "private": true,
  "version": "0.8.0",
  "description": "Step-by-step walkthrough viewer for PIDL protocols",
  "type": "module",
  "scripts": {
    "data": "go run ../cmd/pidl generate -f walkthrough-json -o public/walkthrough.json aauth_protocol",
    "dev": "vite",
    "types": "node scripts/types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:embed": "npm run build && node scripts/embed.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
