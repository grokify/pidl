{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/pidl/schema/pidl.schema.json",
  "title": "PIDL Protocol",
  "description": "Protocol Interaction Description Language - describes protocol choreography for diagram generation",
  "type": "object",
  "required": ["protocol", "entities"],
  "properties": {
    "protocol": {
      "$ref": "#/$defs/protocolMetadata"
    },
    "entities": {
      "type": "array",
      "description": "Participants in the protocol (systems, actors, services)",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 2
    },
    "phases": {
      "type": "array",
      "description": "Optional grouping of flows into logical phases",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "flows": {
      "type": "array",
      "description": "Interactions between entities, as a single unnamed scenario. Use either flows or scenarios, not both.",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "pronunciations": {
      "type": "object",
      "description": "Spoken form of a term per language, such as {\"agent_jkt\": {\"en-US\": \"agent J K T\"}}",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/languageTag" },
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    },
    "groups": {
      "type": "array",
      "description": "Ordered navigation sections that scenarios name in their group. Group order, then scenario order within a group, sets the output order.",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Named, ordered sequences of flows. Array position is the scenario order.",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "anyOf": [
    { "required": ["flows"] },
    { "required": ["scenarios"] }
  ],
  "if": { "required": ["scenarios"] },
  "then": { "properties": { "flows": { "maxItems": 0 } } },
  "else": { "properties": { "flows": { "minItems": 1 } } },
  "$defs": {
    "protocolMetadata": {
      "type": "object",
      "description": "Metadata about the protocol being described",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the protocol",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the protocol"
        },
        "version": {
          "type": "string",
          "description": "Version of the protocol specification"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the protocol"
        },
        "category": {
          "type": "string",
          "description": "Protocol category",
          "enum": ["auth", "agent", "messaging", "provisioning", "other"]
        },
        "references": {
          "type": "array",
          "description": "Links to relevant specifications or documentation",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "language": {
          "$ref": "#/$defs/languageTag",
          "description": "BCP 47 tag of the narration source language and fallback. Defaults to en-US."
        }
      }
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "A BCP 47 language tag, such as en-US, fr or zh-Hans"
    },
    "narration": {
      "type": "object",
      "description": "Text written to be spoken, keyed by BCP 47 language tag. Includes the source language.",
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "briefing": {
      "type": "object",
      "description": "Introduces a scenario before its steps",
      "properties": {
        "why": {
          "type": "string",
          "description": "Why the scenario exists and what problem it solves, as prose"
        },
        "points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Key points, in display order"
        },
        "narration": {
          "$ref": "#/$defs/narration",
          "description": "Spoken over the briefing"
        }
      },
      "additionalProperties": false
    },
    "representationNarration": {
      "type": "object",
      "description": "Narration used when a step is viewed in one representation",
      "properties": {
        "narration": { "$ref": "#/$defs/narration" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the reference (e.g., RFC 6749)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the reference"
        }
      }
    },
    "entity": {
      "type": "object",
      "description": "A participant in the protocol (system, actor, or service)",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the entity, used in flow references",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the entity's role"
        },
        "trust_level": {
          "$ref": "#/$defs/trustLevel"
        },
        "states": {
          "type": "array",
          "description": "Possible states for this entity",
          "items": {
            "$ref": "#/$defs/entityState"
          }
        },
        "protocol_roles": {
          "type": "array",
          "description": "Protocol-specific roles this entity implements",
          "items": {
            "$ref": "#/$defs/protocolRole"
          }
        }
      }
    },
    "protocolRole": {
      "type": "object",
      "description": "A protocol-specific role that an entity implements",
      "required": ["protocol", "role"],
      "properties": {
        "protocol": {
          "type": "string",
          "description": "Protocol identifier",
          "enum": ["oauth", "scim", "spiffe", "aauth", "idjag", "authzen", "mcp", "a2a"]
        },
        "role": {
          "type": "string",
          "description": "Role within that protocol (e.g., authorization_server, client, pep, pdp)"
        },
        "variant": {
          "type": "string",
          "description": "Optional sub-role or variant (e.g., person_server vs access_server)"
        },
        "description": {
          "type": "string",
          "description": "Additional context about this role"
        }
      }
    },
    "entityState": {
      "type": "object",
      "description": "A possible state for an entity",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this state within the entity",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the state"
        },
        "initial": {
          "type": "boolean",
          "description": "Marks this as the initial state",
          "default": false
        },
        "final": {
          "type": "boolean",
          "description": "Marks this as a terminal/final state",
          "default": false
        }
      }
    },
    "entityType": {
      "type": "string",
      "description": "Type classification of the entity",
      "enum": [
        "client",
        "authorization_server",
        "resource_server",
        "user",
        "browser",
        "agent",
        "tool_server",
        "tool",
        "delegated_agent",
        "identity_provider",
        "service_provider",
        "server",
        "other"
      ]
    },
    "phase": {
      "type": "object",
      "description": "A logical grouping of flows",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the phase",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the phase"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the phase"
        },
        "parent": {
          "type": "string",
          "description": "Parent phase ID for nested phases"
        }
      }
    },
    "annotation": {
      "type": "object",
      "description": "A typed annotation on a flow",
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Category of the annotation",
          "enum": ["security", "performance", "deprecated", "info", "warning", "error"]
        },
        "text": {
          "type": "string",
          "description": "The annotation message"
        },
        "details": {
          "type": "string",
          "description": "Additional context or details"
        }
      }
    },
    "alternative": {
      "type": "object",
      "description": "An alternative path in the flow",
      "required": ["condition", "flows"],
      "properties": {
        "condition": {
          "type": "string",
          "description": "Condition that triggers this alternative path"
        },
        "flows": {
          "type": "array",
          "description": "Flows in this alternative path",
          "items": {
            "$ref": "#/$defs/flow"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description of this alternative"
        }
      }
    },
    "scenario": {
      "type": "object",
      "description": "A named, ordered sequence of flows, such as one access mode or user journey",
      "required": ["id", "name", "flows"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique scenario identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "description": "Description of the scenario"
        },
        "participants": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs shown for this scenario, in entities order. Defaults to the entities the scenario uses."
        },
        "fragment": {
          "type": "boolean",
          "description": "Marks a reusable sub-flow that other scenarios include"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "ID of the group this scenario is listed under. Fragments have no group."
        },
        "variant_of": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "ID of the main scenario this one is a variant of, in the same group. A variant follows its base in output order."
        },
        "variant_label": {
          "type": "string",
          "description": "Label for the variant in a toggle, such as \"With user approval\". Required with variant_of."
        },
        "narration": {
          "$ref": "#/$defs/narration",
          "description": "Spoken when the scenario opens"
        },
        "briefing": {
          "$ref": "#/$defs/briefing"
        },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" },
          "description": "Code for the scenario as a whole, such as a role's setup"
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow" },
          "minItems": 1,
          "description": "The scenario's steps, in order"
        }
      },
      "dependentRequired": {
        "variant_of": ["variant_label"],
        "variant_label": ["variant_of"]
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "description": "A navigation section that scenarios are listed under",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique group identifier"
        },
        "name": {
          "type": "string",
          "description": "Display name"
        },
        "description": {
          "type": "string",
          "description": "Description of the group"
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "description": "An interaction between two entities, or an include step that inserts a fragment scenario's flows",
      "oneOf": [
        { "required": ["from", "to", "action"], "not": { "required": ["include"] } },
        {
          "required": ["include"],
          "not": { "anyOf": [{ "required": ["from"] }, { "required": ["to"] }, { "required": ["action"] }] }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Step identifier, unique within its scenario, for deep links, samples and narration. Steps inside an included fragment are addressed as <include>.<id>."
        },
        "narration": {
          "$ref": "#/$defs/narration",
          "description": "Spoken for this step. Tools fall back to description without it."
        },
        "representations": {
          "type": "object",
          "description": "Narration overrides by representation: http, curl, or a sample language on this step",
          "propertyNames": { "pattern": "^[a-z][a-z0-9+#-]*$" },
          "additionalProperties": { "$ref": "#/$defs/representationNarration" }
        },
        "from": {
          "type": "string",
          "description": "Entity ID of the sender/initiator"
        },
        "to": {
          "type": "string",
          "description": "Entity ID of the receiver/target"
        },
        "action": {
          "type": "string",
          "description": "Identifier for the action being performed"
        },
        "include": {
          "type": "string",
          "description": "ID of a fragment scenario whose flows take this step's place. Only allowed in scenarios; an include step has no from, to or action."
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for diagram display (defaults to action)"
        },
        "mode": {
          "$ref": "#/$defs/flowMode"
        },
        "phase": {
          "type": "string",
          "description": "Phase ID this flow belongs to"
        },
        "description": {
          "type": "string",
          "description": "Optional detailed description of the flow"
        },
        "sequence": {
          "type": "integer",
          "description": "Deprecated. Display-only step number; flows are ordered by array position only",
          "deprecated": true,
          "minimum": 1
        },
        "condition": {
          "type": "string",
          "description": "Condition for when this flow is executed (e.g., 'token_valid', 'error')"
        },
        "note": {
          "type": "string",
          "description": "A visible note/annotation displayed on the diagram"
        },
        "annotations": {
          "type": "array",
          "description": "Typed annotations for tooling and documentation",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "alternatives": {
          "type": "array",
          "description": "Alternative paths from this flow point",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "sets": {
          "type": "array",
          "description": "State mutations that occur when this flow executes",
          "items": {
            "$ref": "#/$defs/stateMutation"
          }
        },
        "security": {
          "$ref": "#/$defs/flowSecurity"
        },
        "verification": {
          "$ref": "#/$defs/flowVerification"
        },
        "example": {
          "$ref": "#/$defs/flowExample"
        },
        "match": {
          "$ref": "#/$defs/stepMatch"
        }
      }
    },
    "stepMatch": {
      "type": "object",
      "description": "A rule that says which observed exchanges are this step. Every field is optional; a field left empty is not tested",
      "properties": {
        "method": { "type": "string", "description": "The HTTP method" },
        "path": { "type": "string", "description": "A template whose segments in braces match any one segment, such as /pending/{id}, or a regular expression when it starts with ^" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599, "description": "The response status" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Header name, compared without regard to case, to a value: exact, a prefix when it ends with *, or a regular expression when it starts with ^"
        },
        "body": { "type": "object", "description": "JSON pointer into the request body to the value it must have, or to true when the member must merely exist" },
        "repeat": { "type": "boolean", "description": "The step takes every consecutive exchange that matches it, such as a client polling" },
        "optional": { "type": "boolean", "description": "A run may omit the step without failing a check" }
      }
    },
    "stateMutation": {
      "type": "object",
      "description": "A state change for an entity triggered by a flow",
      "required": ["entity", "to"],
      "properties": {
        "entity": {
          "type": "string",
          "description": "Entity ID whose state changes"
        },
        "to": {
          "type": "string",
          "description": "Target state ID"
        },
        "from": {
          "type": "string",
          "description": "Optional required prior state (for validation)"
        }
      }
    },
    "flowMode": {
      "type": "string",
      "description": "The type/mode of the interaction",
      "enum": [
        "request",
        "response",
        "redirect",
        "callback",
        "interactive",
        "event",
        "tool_call",
        "tool_result"
      ],
      "default": "request"
    },
    "trustLevel": {
      "type": "string",
      "description": "Trust classification of an entity",
      "enum": [
        "trusted",
        "semi_trusted",
        "untrusted",
        "authoritative"
      ]
    },
    "securityRequirement": {
      "type": "string",
      "description": "Security mechanism required for a flow",
      "enum": [
        "token",
        "signature",
        "encryption",
        "mtls",
        "mac"
      ]
    },
    "tokenDefinition": {
      "type": "object",
      "description": "Definition of a token type used in the protocol",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this token definition",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "type": "string",
          "description": "Token type: jwt, opaque, saml, api_key"
        },
        "issuer": {
          "type": "string",
          "description": "Entity ID that issues this token"
        },
        "audience": {
          "type": "string",
          "description": "Entity ID that consumes this token"
        },
        "binding": {
          "type": "string",
          "description": "Token binding method: bearer, mtls, dpop"
        },
        "description": {
          "type": "string",
          "description": "Additional context about the token"
        },
        "verified_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs that check this token"
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenClaim" },
          "description": "Claims that checkers rely on, in display order"
        },
        "carried_in": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenCarriage" },
          "description": "Where the token travels in messages, so it can be found and decoded in exchanges observed in a real system"
        }
      }
    },
    "tokenCarriage": {
      "type": "object",
      "description": "One place a token travels",
      "required": ["in"],
      "properties": {
        "in": { "type": "string", "enum": ["header", "body"] },
        "name": { "type": "string", "description": "The header's name, for a token in a header" },
        "param": { "type": "string", "description": "The structured field parameter holding the token, such as jwt in Signature-Key; empty when the token is the whole value" },
        "path": { "type": "string", "description": "A JSON pointer to the token in the body, for a token in a body" },
        "typ": { "type": "string", "description": "The JWT typ header a value found here must have to be this token, such as aa-agent+jwt; several tokens can travel in one place" }
      }
    },
    "tokenClaim": {
      "type": "object",
      "description": "A claim in a token and the entities that check it",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Claim name, such as aud or agent_jkt"
        },
        "checked_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs that check this claim"
        },
        "description": {
          "type": "string",
          "description": "What the claim carries or how it is checked"
        }
      },
      "additionalProperties": false
    },
    "flowSecurity": {
      "type": "object",
      "description": "Security requirements for a flow",
      "properties": {
        "requires": {
          "type": "array",
          "description": "Security mechanisms required for this flow",
          "items": {
            "$ref": "#/$defs/securityRequirement"
          }
        },
        "token": {
          "type": "string",
          "description": "Token definition ID used for this flow"
        },
        "confidential": {
          "type": "boolean",
          "description": "Whether the flow carries sensitive data",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Additional security context"
        },
        "signed_by": {
          "type": "string",
          "description": "Entity ID that signs the request; defaults to the flow's from entity"
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Token definition IDs this flow delivers"
        },
        "verifies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Token definition IDs the receiver checks"
        }
      }
    },
    "flowExample": {
      "type": "object",
      "description": "Illustrative request, response and decoded tokens for one step",
      "required": ["source", "kind"],
      "anyOf": [
        { "required": ["request"] },
        { "required": ["response"] },
        { "required": ["tokens"] },
        { "required": ["samples"] }
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1, "description": "Citation, such as draft-11 §7.2.1" },
        "kind": { "type": "string", "enum": ["draft", "derived"], "description": "draft: taken from the source with values aligned; derived: written from its normative text" },
        "request": {
          "type": "object",
          "required": ["method", "url"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "headers": { "$ref": "#/$defs/exampleHeaders" },
            "body": { "description": "Request body as JSON" }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "headers": { "$ref": "#/$defs/exampleHeaders" },
            "body": { "description": "Response body as JSON" }
          },
          "additionalProperties": false
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["token"],
            "properties": {
              "token": { "type": "string", "description": "Token definition ID" },
              "label": { "type": "string", "description": "Where the token travels" },
              "header": { "type": "object", "description": "Decoded JWT header" },
              "payload": { "type": "object", "description": "Decoded JWT claims" }
            },
            "additionalProperties": false
          }
        },
        "note": { "type": "string" },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" },
          "description": "Code that sends or handles this message, such as SDK calls"
        }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "description": "Code for a step or scenario: inline code, or a marked region of a file in a repository",
      "required": ["language"],
      "anyOf": [
        { "required": ["code"] },
        { "required": ["source"] }
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+#-]*$",
          "not": { "enum": ["http", "curl"] },
          "description": "Highlighter name of the code's language, such as go, typescript, python or csharp"
        },
        "label": { "type": "string", "description": "Distinguishes samples in one language, such as Agent or Resource" },
        "role": { "type": "string", "description": "Entity ID whose developer writes this code" },
        "code": { "type": "string", "minLength": 1, "description": "Inline code" },
        "source": {
          "type": "object",
          "description": "The code between pidl:begin <region> and pidl:end <region> comments in a file",
          "required": ["repo", "path", "region"],
          "properties": {
            "repo": { "type": "string", "minLength": 1, "description": "Repository path, such as github.com/aauth-dev/aauth-go" },
            "ref": { "type": "string", "description": "Tag or commit to read the file at; empty reads the working tree" },
            "path": { "type": "string", "minLength": 1, "description": "File path within the repository" },
            "region": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "description": "Marked region name" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exampleHeaders": {
      "type": "array",
      "description": "HTTP headers in display order",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "flowVerification": {
      "type": "object",
      "description": "Evidentiary provenance/tier of a flow",
      "required": ["tier"],
      "properties": {
        "tier": {
          "type": "string",
          "description": "How well-substantiated the flow is",
          "enum": ["reported", "corroborated", "reproduced", "partially_reproduced"]
        },
        "source": {
          "type": "string",
          "description": "Where the flow is sourced from (e.g., 'OpenAI technical report', 'METR')"
        },
        "citation": {
          "type": "string",
          "description": "URL or reference locating the source"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional protocol-level configuration",
      "properties": {
        "networks": {
          "type": "object",
          "description": "Network boundary configurations",
          "additionalProperties": {
            "$ref": "#/$defs/networkConfig"
          }
        },
        "network_layout": {
          "$ref": "#/$defs/networkLayout"
        },
        "tokens": {
          "type": "array",
          "description": "Token definitions used in the protocol",
          "items": {
            "$ref": "#/$defs/tokenDefinition"
          }
        },
        "components": {
          "type": "array",
          "description": "Logical deployment components",
          "items": {
            "$ref": "#/$defs/deploymentComponent"
          }
        },
        "trust_relations": {
          "type": "array",
          "description": "Trust relationships between entities or components",
          "items": {
            "$ref": "#/$defs/trustRelationship"
          }
        }
      }
    },
    "deploymentComponent": {
      "type": "object",
      "description": "A logical deployment component that groups entities",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this component",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "type": "string",
          "description": "Component type classification",
          "enum": ["idp", "iga", "agent_provider", "person_server", "access_server", "pdp", "gateway", "mcp_client", "mcp_server", "resource_api", "spire"]
        },
        "description": {
          "type": "string",
          "description": "Additional context about the component"
        },
        "entities": {
          "type": "array",
          "description": "Entity IDs contained in this component",
          "items": {
            "type": "string"
          }
        },
        "implements": {
          "type": "array",
          "description": "Protocol roles this component implements",
          "items": {
            "$ref": "#/$defs/protocolRole"
          }
        },
        "examples": {
          "type": "array",
          "description": "Real-world products that represent this component type",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trustRelationship": {
      "type": "object",
      "description": "A trust relationship between entities or components",
      "required": ["from", "to", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional unique identifier for this relationship"
        },
        "from": {
          "type": "string",
          "description": "Source entity or component ID"
        },
        "to": {
          "type": "string",
          "description": "Target entity or component ID"
        },
        "type": {
          "type": "string",
          "description": "Relationship type",
          "enum": ["authenticates", "validates", "delegates", "authorizes", "issues", "trusts", "provisions", "attests"]
        },
        "credentials": {
          "type": "array",
          "description": "Credentials exchanged in this relationship",
          "items": {
            "type": "string",
            "enum": ["x509_svid", "jwt_svid", "jwt_assertion", "access_token", "id_token", "aa_agent_jwt", "aa_auth_jwt", "mtls", "api_key"]
          }
        },
        "mutual": {
          "type": "boolean",
          "description": "Whether this is a bidirectional trust (e.g., mTLS)",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Additional context about the relationship"
        }
      }
    },
    "networkConfig": {
      "type": "object",
      "description": "Configuration for a network boundary",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for the boundary"
        },
        "style": {
          "type": "string",
          "description": "Visual style: trusted, dmz, external, cloud"
        },
        "entities": {
          "type": "array",
          "description": "Entity IDs in this boundary",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Tooltip/hover text"
        },
        "color": {
          "type": "string",
          "description": "Override default boundary color"
        }
      }
    },
    "networkLayout": {
      "type": "object",
      "description": "Network diagram layout configuration",
      "properties": {
        "direction": {
          "type": "string",
          "description": "Layout direction: horizontal or vertical"
        },
        "order": {
          "type": "array",
          "description": "Boundary ordering",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
