{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/pidl/schema/pidl.schema.json",
  "title": "PIDL Protocol",
  "description": "Protocol Interaction Description Language - describes protocol choreography for diagram generation",
  "type": "object",
  "required": ["protocol", "entities"],
  "properties": {
    "protocol": {
      "$ref": "#/$defs/protocolMetadata"
    },
    "entities": {
      "type": "array",
      "description": "Participants in the protocol (systems, actors, services)",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 2
    },
    "phases": {
      "type": "array",
      "description": "Optional grouping of flows into logical phases",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "flows": {
      "type": "array",
      "description": "Interactions between entities, as a single unnamed scenario. Use either flows or scenarios, not both.",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Named, ordered sequences of flows. Array position is the scenario order.",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "anyOf": [
    { "required": ["flows"] },
    { "required": ["scenarios"] }
  ],
  "if": { "required": ["scenarios"] },
  "then": { "properties": { "flows": { "maxItems": 0 } } },
  "else": { "properties": { "flows": { "minItems": 1 } } },
  "$defs": {
    "protocolMetadata": {
      "type": "object",
      "description": "Metadata about the protocol being described",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the protocol",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the protocol"
        },
        "version": {
          "type": "string",
          "description": "Version of the protocol specification"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the protocol"
        },
        "category": {
          "type": "string",
          "description": "Protocol category",
          "enum": ["auth", "agent", "messaging", "provisioning", "other"]
        },
        "references": {
          "type": "array",
          "description": "Links to relevant specifications or documentation",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the reference (e.g., RFC 6749)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the reference"
        }
      }
    },
    "entity": {
      "type": "object",
      "description": "A participant in the protocol (system, actor, or service)",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the entity, used in flow references",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the entity's role"
        },
        "trust_level": {
          "$ref": "#/$defs/trustLevel"
        },
        "states": {
          "type": "array",
          "description": "Possible states for this entity",
          "items": {
            "$ref": "#/$defs/entityState"
          }
        },
        "protocol_roles": {
          "type": "array",
          "description": "Protocol-specific roles this entity implements",
          "items": {
            "$ref": "#/$defs/protocolRole"
          }
        }
      }
    },
    "protocolRole": {
      "type": "object",
      "description": "A protocol-specific role that an entity implements",
      "required": ["protocol", "role"],
      "properties": {
        "protocol": {
          "type": "string",
          "description": "Protocol identifier",
          "enum": ["oauth", "scim", "spiffe", "aauth", "idjag", "authzen", "mcp", "a2a"]
        },
        "role": {
          "type": "string",
          "description": "Role within that protocol (e.g., authorization_server, client, pep, pdp)"
        },
        "variant": {
          "type": "string",
          "description": "Optional sub-role or variant (e.g., person_server vs access_server)"
        },
        "description": {
          "type": "string",
          "description": "Additional context about this role"
        }
      }
    },
    "entityState": {
      "type": "object",
      "description": "A possible state for an entity",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this state within the entity",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the state"
        },
        "initial": {
          "type": "boolean",
          "description": "Marks this as the initial state",
          "default": false
        },
        "final": {
          "type": "boolean",
          "description": "Marks this as a terminal/final state",
          "default": false
        }
      }
    },
    "entityType": {
      "type": "string",
      "description": "Type classification of the entity",
      "enum": [
        "client",
        "authorization_server",
        "resource_server",
        "user",
        "browser",
        "agent",
        "tool_server",
        "tool",
        "delegated_agent",
        "identity_provider",
        "service_provider",
        "server",
        "other"
      ]
    },
    "phase": {
      "type": "object",
      "description": "A logical grouping of flows",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the phase",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the phase"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the phase"
        },
        "parent": {
          "type": "string",
          "description": "Parent phase ID for nested phases"
        }
      }
    },
    "annotation": {
      "type": "object",
      "description": "A typed annotation on a flow",
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Category of the annotation",
          "enum": ["security", "performance", "deprecated", "info", "warning", "error"]
        },
        "text": {
          "type": "string",
          "description": "The annotation message"
        },
        "details": {
          "type": "string",
          "description": "Additional context or details"
        }
      }
    },
    "alternative": {
      "type": "object",
      "description": "An alternative path in the flow",
      "required": ["condition", "flows"],
      "properties": {
        "condition": {
          "type": "string",
          "description": "Condition that triggers this alternative path"
        },
        "flows": {
          "type": "array",
          "description": "Flows in this alternative path",
          "items": {
            "$ref": "#/$defs/flow"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description of this alternative"
        }
      }
    },
    "scenario": {
      "type": "object",
      "description": "A named, ordered sequence of flows, such as one access mode or user journey",
      "required": ["id", "name", "flows"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique scenario identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "description": "Description of the scenario"
        },
        "participants": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs shown for this scenario, in entities order. Defaults to the entities the scenario uses."
        },
        "fragment": {
          "type": "boolean",
          "description": "Marks a reusable sub-flow that other scenarios include"
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow" },
          "minItems": 1,
          "description": "The scenario's steps, in order"
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "description": "An interaction between two entities, or an include step that inserts a fragment scenario's flows",
      "oneOf": [
        { "required": ["from", "to", "action"], "not": { "required": ["include"] } },
        {
          "required": ["include"],
          "not": { "anyOf": [{ "required": ["from"] }, { "required": ["to"] }, { "required": ["action"] }] }
        }
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "Entity ID of the sender/initiator"
        },
        "to": {
          "type": "string",
          "description": "Entity ID of the receiver/target"
        },
        "action": {
          "type": "string",
          "description": "Identifier for the action being performed"
        },
        "include": {
          "type": "string",
          "description": "ID of a fragment scenario whose flows take this step's place. Only allowed in scenarios; an include step has no from, to or action."
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for diagram display (defaults to action)"
        },
        "mode": {
          "$ref": "#/$defs/flowMode"
        },
        "phase": {
          "type": "string",
          "description": "Phase ID this flow belongs to"
        },
        "description": {
          "type": "string",
          "description": "Optional detailed description of the flow"
        },
        "sequence": {
          "type": "integer",
          "description": "Deprecated. Display-only step number; flows are ordered by array position only",
          "deprecated": true,
          "minimum": 1
        },
        "condition": {
          "type": "string",
          "description": "Condition for when this flow is executed (e.g., 'token_valid', 'error')"
        },
        "note": {
          "type": "string",
          "description": "A visible note/annotation displayed on the diagram"
        },
        "annotations": {
          "type": "array",
          "description": "Typed annotations for tooling and documentation",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "alternatives": {
          "type": "array",
          "description": "Alternative paths from this flow point",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "sets": {
          "type": "array",
          "description": "State mutations that occur when this flow executes",
          "items": {
            "$ref": "#/$defs/stateMutation"
          }
        },
        "security": {
          "$ref": "#/$defs/flowSecurity"
        },
        "verification": {
          "$ref": "#/$defs/flowVerification"
        }
      }
    },
    "stateMutation": {
      "type": "object",
      "description": "A state change for an entity triggered by a flow",
      "required": ["entity", "to"],
      "properties": {
        "entity": {
          "type": "string",
          "description": "Entity ID whose state changes"
        },
        "to": {
          "type": "string",
          "description": "Target state ID"
        },
        "from": {
          "type": "string",
          "description": "Optional required prior state (for validation)"
        }
      }
    },
    "flowMode": {
      "type": "string",
      "description": "The type/mode of the interaction",
      "enum": [
        "request",
        "response",
        "redirect",
        "callback",
        "interactive",
        "event",
        "tool_call",
        "tool_result"
      ],
      "default": "request"
    },
    "trustLevel": {
      "type": "string",
      "description": "Trust classification of an entity",
      "enum": [
        "trusted",
        "semi_trusted",
        "untrusted",
        "authoritative"
      ]
    },
    "securityRequirement": {
      "type": "string",
      "description": "Security mechanism required for a flow",
      "enum": [
        "token",
        "signature",
        "encryption",
        "mtls",
        "mac"
      ]
    },
    "tokenDefinition": {
      "type": "object",
      "description": "Definition of a token type used in the protocol",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this token definition",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "type": "string",
          "description": "Token type: jwt, opaque, saml, api_key"
        },
        "issuer": {
          "type": "string",
          "description": "Entity ID that issues this token"
        },
        "audience": {
          "type": "string",
          "description": "Entity ID that consumes this token"
        },
        "binding": {
          "type": "string",
          "description": "Token binding method: bearer, mtls, dpop"
        },
        "description": {
          "type": "string",
          "description": "Additional context about the token"
        },
        "verified_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs that check this token"
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenClaim" },
          "description": "Claims that checkers rely on, in display order"
        }
      }
    },
    "tokenClaim": {
      "type": "object",
      "description": "A claim in a token and the entities that check it",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Claim name, such as aud or agent_jkt"
        },
        "checked_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Entity IDs that check this claim"
        },
        "description": {
          "type": "string",
          "description": "What the claim carries or how it is checked"
        }
      },
      "additionalProperties": false
    },
    "flowSecurity": {
      "type": "object",
      "description": "Security requirements for a flow",
      "properties": {
        "requires": {
          "type": "array",
          "description": "Security mechanisms required for this flow",
          "items": {
            "$ref": "#/$defs/securityRequirement"
          }
        },
        "token": {
          "type": "string",
          "description": "Token definition ID used for this flow"
        },
        "confidential": {
          "type": "boolean",
          "description": "Whether the flow carries sensitive data",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Additional security context"
        },
        "signed_by": {
          "type": "string",
          "description": "Entity ID that signs the request; defaults to the flow's from entity"
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Token definition IDs this flow delivers"
        },
        "verifies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Token definition IDs the receiver checks"
        }
      }
    },
    "flowVerification": {
      "type": "object",
      "description": "Evidentiary provenance/tier of a flow",
      "required": ["tier"],
      "properties": {
        "tier": {
          "type": "string",
          "description": "How well-substantiated the flow is",
          "enum": ["reported", "corroborated", "reproduced", "partially_reproduced"]
        },
        "source": {
          "type": "string",
          "description": "Where the flow is sourced from (e.g., 'OpenAI technical report', 'METR')"
        },
        "citation": {
          "type": "string",
          "description": "URL or reference locating the source"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional protocol-level configuration",
      "properties": {
        "networks": {
          "type": "object",
          "description": "Network boundary configurations",
          "additionalProperties": {
            "$ref": "#/$defs/networkConfig"
          }
        },
        "network_layout": {
          "$ref": "#/$defs/networkLayout"
        },
        "tokens": {
          "type": "array",
          "description": "Token definitions used in the protocol",
          "items": {
            "$ref": "#/$defs/tokenDefinition"
          }
        },
        "components": {
          "type": "array",
          "description": "Logical deployment components",
          "items": {
            "$ref": "#/$defs/deploymentComponent"
          }
        },
        "trust_relations": {
          "type": "array",
          "description": "Trust relationships between entities or components",
          "items": {
            "$ref": "#/$defs/trustRelationship"
          }
        }
      }
    },
    "deploymentComponent": {
      "type": "object",
      "description": "A logical deployment component that groups entities",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this component",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "type": {
          "type": "string",
          "description": "Component type classification",
          "enum": ["idp", "iga", "agent_provider", "person_server", "access_server", "pdp", "gateway", "mcp_client", "mcp_server", "resource_api", "spire"]
        },
        "description": {
          "type": "string",
          "description": "Additional context about the component"
        },
        "entities": {
          "type": "array",
          "description": "Entity IDs contained in this component",
          "items": {
            "type": "string"
          }
        },
        "implements": {
          "type": "array",
          "description": "Protocol roles this component implements",
          "items": {
            "$ref": "#/$defs/protocolRole"
          }
        },
        "examples": {
          "type": "array",
          "description": "Real-world products that represent this component type",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trustRelationship": {
      "type": "object",
      "description": "A trust relationship between entities or components",
      "required": ["from", "to", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional unique identifier for this relationship"
        },
        "from": {
          "type": "string",
          "description": "Source entity or component ID"
        },
        "to": {
          "type": "string",
          "description": "Target entity or component ID"
        },
        "type": {
          "type": "string",
          "description": "Relationship type",
          "enum": ["authenticates", "validates", "delegates", "authorizes", "issues", "trusts", "provisions", "attests"]
        },
        "credentials": {
          "type": "array",
          "description": "Credentials exchanged in this relationship",
          "items": {
            "type": "string",
            "enum": ["x509_svid", "jwt_svid", "jwt_assertion", "access_token", "id_token", "aa_agent_jwt", "aa_auth_jwt", "mtls", "api_key"]
          }
        },
        "mutual": {
          "type": "boolean",
          "description": "Whether this is a bidirectional trust (e.g., mTLS)",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Additional context about the relationship"
        }
      }
    },
    "networkConfig": {
      "type": "object",
      "description": "Configuration for a network boundary",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for the boundary"
        },
        "style": {
          "type": "string",
          "description": "Visual style: trusted, dmz, external, cloud"
        },
        "entities": {
          "type": "array",
          "description": "Entity IDs in this boundary",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Tooltip/hover text"
        },
        "color": {
          "type": "string",
          "description": "Override default boundary color"
        }
      }
    },
    "networkLayout": {
      "type": "object",
      "description": "Network diagram layout configuration",
      "properties": {
        "direction": {
          "type": "string",
          "description": "Layout direction: horizontal or vertical"
        },
        "order": {
          "type": "array",
          "description": "Boundary ordering",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
